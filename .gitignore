# build / deps
node_modules/
dist/

# test artifacts (huge: ProvenanceData *.ort ~170MB each)
# ⚠ 不要用裸 `/tests/`：那会把「想提交的自测脚本」一起吞掉（PR #7 评审 🟡1/🟡3 的实际后果 ——
#   package.json 指向的 tests/entry-match.test.mjs 根本没进仓库，`npm run net:entry-test` 必失败）。
#   这里只收窄屏蔽体积巨大的采样数据；仓库自测统一放 src/**/*.test.ts(|.mjs)（与既有 RtcPeer.test 一致）。
/tests/ProvenanceData/
/tests/**/ProvenanceData/

# e2e 真机实测的依赖与浏览器缓存（Chromium ~400MB，绝不入库）
#   跑法见 scripts/e2e/run-verify.sh（自动 npm i puppeteer + 下载 Chromium 到 tests/e2e/）
/tests/e2e/.chrome/
/tests/e2e/node_modules/
/tests/e2e/package.json
/tests/e2e/package-lock.json

# tunneling binaries & configs (may contain tokens) - never commit
tools/
*.exe
*.zip
*.msi
*.lnk

# deploy 运行时产物（令牌 / 登记入口，绝不入库）
.tank-deploy/

# logs / temp
*.log
*.log.*
*.txt
.tmp-*
cf.*
cpolar*

# editor / probe
.probe/
.trae/
.vscode/

# os
Thumbs.db
desktop.ini
