{
  "name": "web-tank-battle",
  "version": "0.1.0",
  "description": "Noita风格弹药组装  FC坦克大战  肉鸽Roguelike 网页游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "online": "node server/index.mjs",
    "test": "vitest run && npm run net:entry-test && npm run net:server-test",
    "test:watch": "vitest",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "dual": "node scripts/quick-dual-test.mjs",
    "host-ai": "node scripts/ai-host.mjs",
    "net:tunnel": "node scripts/net-tunnel.mjs",
    "net:latency": "node scripts/net-latency.mjs",
    "deploy:server": "bash deploy/start-server.sh",
    "net:entry-test": "node --test src/net/entry-match.test.mjs",
    "net:server-test": "node --test src/net/server-access.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npx tsc --noEmit && npm run build && npx vitest run && npm run net:entry-test && npm run net:server-test",
    "test:local": "sh scripts/e2e/run-verify.sh"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
